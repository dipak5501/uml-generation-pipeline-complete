# Copied from the development Mac with secrets removed. Copy to .env and fill tokens.
GH_TOKEN=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HF_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Qwen2.5-VL on Ollama 0.32 (mllama/LLaMA-Vision needs 0.24 on :11434)
OLLAMA_QWEN_BASE_URL=http://127.0.0.1:11435
SPEC_MODEL=meta-llama/Llama-3.2-1B-Instruct
CODE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
VLM_MODELS=qwen2.5vl:3b,llama3.2-vision:11b,aya-vision:8b
# Paper: Qwen2.5-VL-3B / LLaMA-3.2-11B-Vision / Aya-Vision-8B (MMMU 53.1/50.7/39.9)
# Aya not on Ollama → auto-maps to llava:7b; Qwen routed to :11435 (Ollama 0.32)
MOCK_PROVIDERS=false
USE_OLLAMA=true
# while keeping paper MMMU weight key aya_vision_8b=39.9

USE_FINETUNED_CODE=true
FINETUNED_BASE_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
FINETUNED_ADAPTER_PATH=models/uml-plantuml-lora
FINETUNED_MAX_TOKENS=768
PLANTUML_REMOTE=true
PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml
JAVA_HOME=tools/jdk-17.0.19+10-jre/Contents/Home

# Hugging Face Inference Providers (off — using Ollama locally)
USE_HF_INFERENCE=false
HF_BASE_URL=https://router.huggingface.co/v1

# Reliability / demo speed
VLM_FAST_MODE=false
PLANTUML_PREFER_LOCAL=true

# Paper VLM #3 — Aya-Vision-8B is NOT on Ollama.
# ollama_standin (current) | hf | openai_compat (vLLM on GCP/GPU for paper-exact Aya)
VLM_AYA_BACKEND=local
AYA_VLM_MODEL=/Users/dslc/Desktop/UML/data/aya_weights
AYA_VLM_BASE_URL=

# Skip Aya-Vision-8B until explicitly enabled
USE_AYA=false
